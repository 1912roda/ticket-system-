<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User</title>
    <link rel="stylesheet" href="/style.css">

</head>
<body>
    <div class="user-header">
    <h1>User Bereich</h1>

<p>Eingeloggt als: <%= username %></p>
<a href="/logout">Logout</a>
<h2>Ticket erstellen</h2>
</div>

<div class="user-box">

<form action="/tickets" method="POST" enctype="multipart/form-data">

    <label>Titel:</label>
    <input type="text" name="titel">

    <br><br>

    <label>Kategorie:</label>
    <select name="kategorie">
        <option value="Hardware">Hardware</option>
        <option value="Software">Software</option>
        <option value="Benutzerkonto">Benutzerkonto</option>
        <option value="Meona">Meona</option>
        <option value="Sonstiges">Sonstiges</option>
    </select>

    <br><br>

    <label>Fehlerbeschreibung:</label>
    <textarea name="beschreibung"></textarea>

    <br><br>
    
    

    <label>Priorität:</label>
    <select name="prioritaet">
        <option value="Niedrig">Niedrig</option>
        <option value="Mittel">Mittel</option>
        <option value="Hoch">Hoch</option>
    </select>

    <br><br>

<label>Anhang:</label>
<input type="file" name="anhang">

<br><br>
    <button type="submit">Ticket erstellen</button>

</form>
</div>
<div class="user-ticket-box">

    <% tickets.forEach(ticket => { %>

        <h2><%= ticket.titel %></h2>
        <p>Kategorie: <%= ticket.kategorie %></p>
        <p>beschreibung:<%= ticket.beschreibung %></p>
        <p>Priorität: <%= ticket.prioritaet %></p>
        <p>Status: <%= ticket.status %></p>
<% if (ticket.admin_kommentar) { %>
    <p>Antwort vom Admin: <%= ticket.admin_kommentar %></p>
<% } %>
        <hr>

    <% }); %>
    </div>
    
</body>
</html>